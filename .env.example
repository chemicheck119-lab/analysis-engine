# 실제 키는 저장소에 커밋하지 말고 배포 플랫폼의 Secret으로 주입합니다.
# `openssl rand -hex 32` 결과를 사용합니다.
CHEMIGUARD119_API_KEY=64자리-HEX-난수로-교체
# `chemiguard119 release-manifest --json` 결과의 manifest_sha256 값
CHEMIGUARD119_RUNTIME_MANIFEST_SHA256=64자리-SHA256으로-교체
# runtime manifest를 생성한 clean release commit SHA
CHEMIGUARD119_GIT_COMMIT=40자리-GIT-COMMIT-SHA로-교체
# 독립 검수 release attestation 생성·빌드 검증용 32바이트 이상 HMAC Secret.
# 이미지·저장소·실행 컨테이너에는 넣지 말고 검수 환경과 build secret에만 주입합니다.
CHEMIGUARD119_RELEASE_ATTESTATION_HMAC_KEY=32바이트-이상의-별도-검수-비밀키로-교체
# 전문가 승인 없이 공개 CAMEO 근거로 스크리닝하는 기본 정책
CHEMIGUARD119_RULE_POLICY=PUBLIC_SOURCE_PILOT_V1
# JSON 운영 로그 수준. 지원하지 않는 값은 안전한 기본값 INFO로 처리합니다.
CHEMIGUARD119_LOG_LEVEL=INFO
# 대응 근거 요약. 기본 extractive는 외부 LLM 없이 공식 근거 문장을 그대로 조립합니다.
# off | extractive | llm
CHEMIGUARD119_RAG_MODE=extractive
# llm 모드에서만 사용합니다. LM Studio 기본 주소 또는 배포된 OpenAI-compatible 주소입니다.
CHEMIGUARD119_RAG_BASE_URL=http://127.0.0.1:1234/v1
CHEMIGUARD119_RAG_MODEL=LM-Studio에-로드한-모델-ID로-교체
# 외부 서버가 인증을 요구할 때만 Secret으로 주입합니다. 로컬 LM Studio는 비워둘 수 있습니다.
CHEMIGUARD119_RAG_API_KEY=
CHEMIGUARD119_RAG_TIMEOUT_SECONDS=8
# KOSHA 공식 MSDS OpenAPI 수집 전용 키. 운영 API 컨테이너에는 주입하지 않아도 됩니다.
KOSHA_API_SERVICE_KEY=공공데이터포털에서-발급받은-디코딩-서비스키
