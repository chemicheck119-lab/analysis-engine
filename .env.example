# 실제 키는 저장소에 커밋하지 말고 배포 플랫폼의 Secret으로 주입합니다.
CHEMIGUARD119_API_KEY=32자-이상의-임의-비밀키로-교체
# `chemiguard119 release-manifest --json` 결과의 manifest_sha256 값
CHEMIGUARD119_RUNTIME_MANIFEST_SHA256=64자리-SHA256으로-교체
# runtime manifest를 생성한 clean release commit SHA
CHEMIGUARD119_GIT_COMMIT=40자리-GIT-COMMIT-SHA로-교체
# 전문가 승인 없이 공개 CAMEO 근거로 스크리닝하는 기본 정책
CHEMIGUARD119_RULE_POLICY=PUBLIC_SOURCE_PILOT_V1
# KOSHA 공식 MSDS OpenAPI 수집 전용 키. 운영 API 컨테이너에는 주입하지 않아도 됩니다.
KOSHA_API_SERVICE_KEY=공공데이터포털에서-발급받은-디코딩-서비스키
